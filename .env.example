# Local configuration for the arXiv synchronization script.
# Author: Ellen Song <jiaqi.song@z.ai>

ZHIPU_API_KEY=
ZHIPU_CLASSIFIER_MODEL=glm-5-turbo

# ─────────────────────────────────────────────────────────────────────────────
# Feishu application-bot notifications (optional; only needed for the
# `notifications` package). Never commit real credentials. These are example
# placeholders only.
#
# FEISHU_TARGETS_JSON must be a JSON array of objects, e.g.:
#   [
#     {
#       "id": "paper-research-group",
#       "name": "论文研究群",
#       "receive_id_type": "chat_id",
#       "receive_id": "oc_replace_with_real_chat_id"
#     },
#     {
#       "id": "ellen",
#       "name": "Ellen",
#       "receive_id_type": "open_id",
#       "receive_id": "ou_replace_with_real_open_id"
#     }
#   ]
#
# receive_id_type must be one of: chat_id, open_id, user_id, union_id, email.
#
# 在本地用 `set -a; source .env; set +a` 加载时，务必给 FEISHU_TARGETS_JSON
# 的值套**单引号**（如 FEISHU_TARGETS_JSON='[...]'），否则 shell 会吞掉 JSON
# 里的双引号，导致解析失败。多行 JSON 需先压成单行再放进单引号里。
# ─────────────────────────────────────────────────────────────────────────────
FEISHU_APP_ID=cli_replace_with_real_app_id
FEISHU_APP_SECRET=replace_with_real_app_secret
FEISHU_TARGETS_JSON='[]'
FEISHU_PAPERS_PATH=public/data/zhipu_papers.json
FEISHU_STATE_PATH=.notification-state/feishu.json
FEISHU_SITE_URL=https://ellensong77.github.io/ZAI-Paper/
