.env
.venv/
.DS_Store
node_modules/
.cache/
__pycache__/
.pytest_cache/
*.pyc
logs/
*.bak

# The notification state (.notification-state/feishu.json) is meant to be
# committed once the go-live checklist reaches `bootstrap` (see README);
# before that the file does not exist yet and `send` correctly refuses to
# run (fail-closed). The per-run pending_push.json cache and atomic-write
# temp files are never tracked: the cache is regenerated by every
# incremental sync and consumed/deleted by `send`, so it must stay local.
.notification-state/*.tmp
.notification-state/pending_push.json
